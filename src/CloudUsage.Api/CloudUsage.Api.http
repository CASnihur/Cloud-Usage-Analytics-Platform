@CloudUsage.Api_HostAddress = http://localhost:5073
@BatchEventId = 24952492-6850-4bdd-aebf-49d0e0053555

GET {{CloudUsage.Api_HostAddress}}/health
Accept: application/json

###

# First submission: overall 200, item statuses 400, 201, 409.
# Repeat submission: overall 200, item statuses 400, 409, 409.
POST {{CloudUsage.Api_HostAddress}}/api/usage-events/batch
Content-Type: application/json

{
  "events": [
    123,
    {
      "eventId": "{{BatchEventId}}",
      "userId": "batch-user",
      "productCode": "studio",
      "eventType": "feature_used",
      "occurredAtUtc": "2026-09-19T10:00:00Z"
    },
    {
      "eventId": "{{BatchEventId}}",
      "userId": "batch-user",
      "productCode": "studio",
      "eventType": "feature_used",
      "occurredAtUtc": "2026-09-19T10:00:00Z"
    }
  ]
}

###

# Send twice with the same eventId to observe 201 followed by 409.
POST {{CloudUsage.Api_HostAddress}}/api/usage-events
Content-Type: application/json

{
  "eventId": "73f529e4-1e11-4c7f-8ec5-d04d06e40f67",
  "userId": "user-1042",
  "productCode": "studio",
  "eventType": "feature_used",
  "occurredAtUtc": "2026-09-05T10:30:00Z",
  "properties": { "featureName": "Workflow Analyzer" }
}
